{
  "expo": {
    "name": "Numo",
    "slug": "numo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "numo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#070A0F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.numo.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Numo uses Face ID to securely unlock your financial records.",
        "NSMicrophoneUsageDescription": "Numo uses the microphone for hands-free 'Hey Numo' voice navigation and financial actions."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#070A0F"
      },
      "package": "com.numo.app",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-secure-store",
      "@clerk/expo",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Numo to use Face ID for fast and secure access to your finances."
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
