# ==========================================
# Numo Mobile (Expo) Environment Variables
# ==========================================

# Clerk Authentication (Client Publishable Key)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key

# Neon PostgreSQL Database Connection URL (Serverless)
DATABASE_URL=postgresql://user:password@ep-placeholder.region.aws.neon.tech/numo?sslmode=require

# ImageKit.io CDN & Upload
EXPO_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/numo
EXPO_PUBLIC_IMAGEKIT_PUBLIC_KEY=public_placeholder_key

# Sentry Telemetry
EXPO_PUBLIC_SENTRY_DSN=https://placeholder@o0.ingest.sentry.io/0
